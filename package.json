  "description": "Quiniela del Mundial 2026 en Google Apps Script, con pruebas de seguridad y demo estática.",
  "license": "MIT",
  "author": "Carlos (Aloner23)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
